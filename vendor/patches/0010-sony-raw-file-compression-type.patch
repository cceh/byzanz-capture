diff --git a/camlibs/ptp2/config.c b/camlibs/ptp2/config.c
index 94c499530..46d79d926 100644
--- a/camlibs/ptp2/config.c
+++ b/camlibs/ptp2/config.c
@@ -7378,6 +7378,30 @@ static struct deviceproptableu8 sony_qx_compression[] = {
 };
 GENERIC8TABLE(Sony_QX_Compression,sony_qx_compression)
 
+/* Sony 0xD288 (CrDeviceProperty_RAW_FileCompressionType), the A7R V's
+ * "RAW File Type" menu.
+ *
+ * Only the values confirmed against a real body are labelled here. Everything
+ * else the camera offers still shows up, as "Unknown value 00xx" — settable,
+ * just unlabelled — which is deliberate: a mislabelled entry would silently
+ * write the wrong RAW type.
+ *
+ * Do NOT fill the rest in from the Camera Remote SDK's CrRAWFileCompressionType
+ * enum (0 Uncompression, 1 Compression, 2 LossLess, 3 LossLessS, 4 LossLessM,
+ * 5 LossLessL). SDK enum numbers are not the PTP wire values in general: for
+ * StillImageStoreDestination (0xD222) the SDK says 1/2/3 while the wire uses
+ * 0x01/0x10/0x11, and for JpegQuality (0xD252) the SDK order (1=Light ..
+ * 4=ExFine) is the reverse of the observed wire order (1=X.Fine .. 4=Light).
+ *
+ * Confirmed so far (ILCE-7RM5, config export 2026-07-10 cross-checked against
+ * the body's own menu): 0x01 = Compressed. That the SDK also numbers
+ * Compression 1 rules out a reversed order, but says nothing about the rest —
+ * match each remaining value against the camera menu before labelling it. */
+static struct deviceproptableu8 sony_rawfilecompressiontype[] = {
+	{ N_("Compressed"),	0x01, 0 },
+};
+GENERIC8TABLE(Sony_RAWFileCompressionType,sony_rawfilecompressiontype)
+
 static struct deviceproptableu8 sony_pc_save_image_size[] = {
 	{ N_("Original"), 0x01, 0 },
 	{ N_("2M"),       0x02, 0 },
@@ -11720,6 +11744,7 @@ static struct submenu capture_settings_menu[] = {
 	{ N_("Image Quality"),                  "imagequality",             PTP_DPC_CompressionSetting,             PTP_VENDOR_SONY,    PTP_DTC_UINT8,  _get_CompressionSetting,            _put_Sony_CompressionSetting },
 	{ N_("Image Quality"),                  "imagequality",             PTP_DPC_CompressionSetting,             0,                  PTP_DTC_UINT8,  _get_CompressionSetting,            _put_CompressionSetting },
 	{ N_("JPEG Quality"),                   "jpegquality",              PTP_DPC_SONY_JpegQuality,               PTP_VENDOR_SONY,    PTP_DTC_UINT8,  _get_Sony_300_JpegCompressionSetting, _put_Sony_300_JpegCompressionSetting },
+	{ N_("RAW File Compression Type"),      "rawcompression",           PTP_DPC_SONY_RAWFileCompressionType,    PTP_VENDOR_SONY,    PTP_DTC_UINT8,  _get_Sony_RAWFileCompressionType,   _put_Sony_RAWFileCompressionType },
 	{ N_("PC Save Image Size"),             "pcsaveimgsize",            PTP_DPC_SONY_PcSaveImageSize,           PTP_VENDOR_SONY,    PTP_DTC_UINT8,  _get_Sony_PcSaveImageSize,          _put_Sony_PcSaveImageSize },
 	{ N_("RAW+J PC Save Image"),            "pcsaveimgformat",          PTP_DPC_SONY_PcSaveImageFormat,         PTP_VENDOR_SONY,    PTP_DTC_UINT8,  _get_Sony_PcSaveImageFormat,        _put_Sony_PcSaveImageFormat },
 	{ N_("Focus Distance"),                 "focusdistance",            PTP_DPC_FocusDistance,                  0,                  PTP_DTC_UINT16, _get_FocusDistance,                 _put_FocusDistance },
