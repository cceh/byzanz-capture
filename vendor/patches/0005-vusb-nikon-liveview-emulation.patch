+/* byzanz-capture (patch 0005): minimal Nikon liveview emulation.
+ *
+ * The ptp2 camlib's camera_capture_preview() Nikon path needs exactly:
+ *   - StartLiveView (0x9201) advertised and answering OK,
+ *   - DeviceReady (0x90c8) answering OK (nikon_wait_busy polls it after
+ *     the start),
+ *   - GetLiveViewImg (0x9203) returning a data phase containing a JPEG —
+ *     the camlib scans for the SOI marker itself (see
+ *     save_jpeg_in_data_to_preview), so a raw JPEG without the
+ *     model-specific Nikon header is fine.
+ * Every other liveview-adjacent property (RecordingMedia,
+ * LiveViewProhibitCondition, ...) is skipped by the camlib as long as it
+ * is not advertised in GetDeviceInfo. */
+
+static int
+ptp_nikon_deviceready_write(vcamera *cam, ptpcontainer *ptp) {
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	CHECK_PARAM_COUNT(0);
+
+	/* The emulator is never busy. An explicit handler (the unknown-
+	 * opcode fallback would answer OK too) keeps nikon_wait_busy's
+	 * polling out of the error log. */
+	ptp_response (cam, PTP_RC_OK, 0);
+	return 1;
+}
+
+static int
+ptp_nikon_startliveview_write(vcamera *cam, ptpcontainer *ptp) {
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	CHECK_PARAM_COUNT(0);
+
+	cam->liveview = 1;
+	cam->liveview_frame = 0;
+	ptp_response (cam, PTP_RC_OK, 0);
+	return 1;
+}
+
+static int
+ptp_nikon_endliveview_write(vcamera *cam, ptpcontainer *ptp) {
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	CHECK_PARAM_COUNT(0);
+
+	cam->liveview = 0;
+	ptp_response (cam, PTP_RC_OK, 0);
+	return 1;
+}
+
+static int
+cmp_frame_names(const void *a, const void *b) {
+	return strcmp (*(const char * const *)a, *(const char * const *)b);
+}
+
+static void *
+read_file_at_path(const char *path, unsigned long *size) {
+	struct stat	st;
+	FILE		*file;
+	void		*data;
+
+	if (-1 == stat(path, &st)) {
+		gp_log (GP_LOG_ERROR, __FUNCTION__, "could not stat %s", path);
+		return NULL;
+	}
+	file = fopen(path, "rb");
+	if (!file) {
+		gp_log (GP_LOG_ERROR, __FUNCTION__, "could not open %s", path);
+		return NULL;
+	}
+	data = malloc(st.st_size);
+	if (!data) {
+		gp_log (GP_LOG_ERROR, __FUNCTION__, "could not allocate data for %s", path);
+		fclose(file);
+		return NULL;
+	}
+	if (!fread(data, st.st_size, 1, file)) {
+		gp_log (GP_LOG_ERROR, __FUNCTION__, "could not read data of %s", path);
+		free(data);
+		data = NULL;
+	}
+	fclose(file);
+	*size = st.st_size;
+	return data;
+}
+
+/* Return the malloc'd contents of the next liveview frame and advance
+ * the frame counter. Frames are the sorted .jpg/.JPG files in
+ * VCAMERADIR/liveview — a directory read_directories deliberately keeps
+ * out of the PTP object tree; scripts/bootstrap-gphoto2.sh seeds it with
+ * a short drift animation. Without that directory the first JPEG of the
+ * object tree — the same pick InitiateCapture duplicates — is served
+ * instead: the stream is static then, but preview and capture agree. */
+static void *
+read_liveview_frame(vcamera *cam, unsigned long *size) {
+	const char	*basedir;
+	char		*lvdir, *path = NULL;
+	char		**names = NULL;
+	unsigned int	nrofnames = 0, i;
+	gp_system_dir	dir;
+	gp_system_dirent	de;
+	void		*data;
+
+	basedir = getenv("VCAMERADIR");
+	if (!basedir)
+		basedir = VCAMERADIR;
+	lvdir = aprintf("%s/liveview", basedir);
+
+	dir = gp_system_opendir(lvdir);
+	if (dir) {
+		while ((de = gp_system_readdir(dir))) {
+			const char *name = gp_system_filename(de);
+
+			if (!strstr(name, ".jpg") && !strstr(name, ".JPG"))
+				continue;
+			names = realloc(names, (nrofnames+1)*sizeof(names[0]));
+			names[nrofnames++] = strdup(name);
+		}
+		gp_system_closedir(dir);
+	}
+
+	if (nrofnames) {
+		qsort(names, nrofnames, sizeof(names[0]), cmp_frame_names);
+		path = aprintf("%s/%s", lvdir, names[cam->liveview_frame++ % nrofnames]);
+	} else {
+		struct ptp_dirent *cur = cam->first_dirent;
+
+		while (cur) {
+			if (strstr(cur->name, ".jpg") || strstr(cur->name, ".JPG"))
+				break;
+			cur = cur->next;
+		}
+		if (cur)
+			path = strdup(cur->fsname);
+		else
+			gp_log (GP_LOG_ERROR, __FUNCTION__, "no frames in %s and no JPG in the object tree", lvdir);
+	}
+
+	data = path ? read_file_at_path(path, size) : NULL;
+
+	for (i = 0; i < nrofnames; i++)
+		free(names[i]);
+	free(names);
+	free(path);
+	free(lvdir);
+	return data;
+}
+
+static int
+ptp_nikon_getliveviewimg_write(vcamera *cam, ptpcontainer *ptp) {
+	void		*data;
+	unsigned long	size = 0;
+
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	CHECK_PARAM_COUNT(0);
+
+	if (!cam->liveview) {
+		ptp_response (cam, PTP_RC_NIKON_NotLiveView, 0);
+		return 1;
+	}
+	data = read_liveview_frame(cam, &size);
+	if (!data) {
+		ptp_response (cam, PTP_RC_GeneralError, 0);
+		return 1;
+	}
+	ptp_senddata (cam, 0x9203, data, size);
+	free (data);
+	ptp_response (cam, PTP_RC_OK, 0);
+	return 1;
+}
