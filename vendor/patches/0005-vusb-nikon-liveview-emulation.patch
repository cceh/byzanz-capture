 }
 
+/* byzanz-capture (patch 0005): Nikon LiveViewStatus (0xD1A2), Get only.
+ * Unlike the properties above this injects NO DevicePropChanged event:
+ * the ptp2 camlib reads it before every preview frame (20/s), and a
+ * queued interrupt per read would flood the event queue. */
+static int
+ptp_nikon_liveviewstatus_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	desc->DevicePropCode		= 0xD1A2;
+	desc->DataType			= 2;	/* uint8 */
+	desc->GetSet			= 0;	/* Get only */
+	desc->DefaultValue.u8		= 0;
+	desc->CurrentValue.u8		= cam->liveview ? 1 : 0;
+	desc->FormFlag			= 0x01; /* range */
+	desc->FORM.Range.MinValue.u8	= 0;
+	desc->FORM.Range.MaxValue.u8	= 1;
+	desc->FORM.Range.StepSize.u8	= 1;
+	return 1;
+}
+
+static int
+ptp_nikon_liveviewstatus_getvalue (vcamera* cam, PTPPropValue *val) {
+	val->u8 = cam->liveview ? 1 : 0;
+	return 1;
+}
