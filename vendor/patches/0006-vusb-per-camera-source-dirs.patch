diff --git a/libgphoto2_port/vusb/vcamera.c b/libgphoto2_port/vusb/vcamera.c
index 22df88bcf..da2303811 100644
--- a/libgphoto2_port/vusb/vcamera.c
+++ b/libgphoto2_port/vusb/vcamera.c
@@ -448,6 +448,17 @@ struct ptp_dirent {
  * gives each camera its own virtual filesystem, as two real cameras have. */
 
 static void *read_file(struct ptp_dirent *cur) {
+	/* byzanz-capture (patch 0006): refresh the cached stat before
+	 * reading. The tree caches stbuf at scan time; a seed image swapped
+	 * on disk since (live content switching while testing) would
+	 * otherwise be read with the stale size — truncated or over-read.
+	 * The GetObject/GetThumb handlers pass cur->stbuf.st_size to
+	 * ptp_senddata right after this call, so refreshing here keeps the
+	 * data phase consistent with what is actually sent. */
+	if (-1 == stat(cur->fsname, &cur->stbuf)) {
+		gp_log (GP_LOG_ERROR,__FUNCTION__, "could not stat %s", cur->fsname);
+		return NULL;
+	}
 	FILE *file = fopen(cur->fsname, "rb");
 	if (!file) {
 		gp_log (GP_LOG_ERROR,__FUNCTION__, "could not open %s", cur->fsname);
@@ -650,7 +661,6 @@ read_file_at_path(const char *path, unsigned long *size) {
  * instead: the stream is static then, but preview and capture agree. */
 static void *
 read_liveview_frame(vcamera *cam, unsigned long *size) {
-	const char	*basedir;
 	char		*lvdir, *path = NULL;
 	char		**names = NULL;
 	unsigned int	nrofnames = 0, i;
@@ -658,10 +668,14 @@ read_liveview_frame(vcamera *cam, unsigned long *size) {
 	gp_system_dirent	de;
 	void		*data;
 
-	basedir = getenv("VCAMERADIR");
-	if (!basedir)
-		basedir = VCAMERADIR;
-	lvdir = aprintf("%s/liveview", basedir);
+	/* byzanz-capture (patch 0006): the source dir is per-camera,
+	 * resolved once in vcam_open. PTP traffic implies an opened port,
+	 * so this can only be NULL if that contract ever breaks. */
+	if (!cam->vcameradir) {
+		gp_log (GP_LOG_ERROR, __FUNCTION__, "no source dir resolved — camera not opened?");
+		return NULL;
+	}
+	lvdir = aprintf("%s/liveview", cam->vcameradir);
 
 	dir = gp_system_opendir(lvdir);
 	if (dir) {
@@ -1376,6 +1390,15 @@ ptp_initiatecapture_write(vcamera *cam, ptpcontainer *ptp) {
 		return 1;
 	}
 
+	/* byzanz-capture (patch 0006): refresh the source's stat before
+	 * copying it, so the new object's ObjectInfo reports the size of
+	 * what is on disk NOW — the seed may have been swapped since the
+	 * tree was read (live content switching while testing). A failed
+	 * stat keeps the cached values; read_file will then fail loudly
+	 * when the object is fetched. */
+	if (-1 == stat(cur->fsname, &cur->stbuf))
+		gp_log (GP_LOG_ERROR,__FUNCTION__, "could not stat %s", cur->fsname);
+
 	newcur 		= malloc (sizeof(struct ptp_dirent));
 	newcur->id	= ++cam->ptp_objectid;
 	newcur->fsname	= strdup(cur->fsname);
@@ -2030,6 +2053,36 @@ static int vcam_exit(vcamera* cam) {
 }
 
 static int vcam_open(vcamera* cam, const char *port) {
+	/* byzanz-capture (patch 0006): resolve this camera's source
+	 * directory, then read the object tree from it. Precedence:
+	 *   1. VCAMERADIR_<suffix> — suffix is what follows "vusb:" in the
+	 *      port path, so "vusb:2" reads VCAMERADIR_2. Per-camera
+	 *      override: lets the two virtual cameras serve different
+	 *      image sets (e.g. VIS vs IR test material).
+	 *   2. VCAMERADIR — process-global override (upstream behavior,
+	 *      now the shared fallback).
+	 *   3. The compiled-in default.
+	 * Resolved here and not in vcamera_new because only open() learns
+	 * the port. Re-opens keep the first tree (read_tree guards on
+	 * first_dirent), matching the previous read-once-per-camera
+	 * behavior. */
+	if (!cam->vcameradir) {
+		const char	*dir = NULL, *suffix;
+		char		envname[64];
+
+		suffix = strchr(port, ':');
+		if (suffix && suffix[1]) {
+			snprintf(envname, sizeof(envname), "VCAMERADIR_%s", suffix+1);
+			dir = getenv(envname);
+		}
+		if (!dir)
+			dir = getenv("VCAMERADIR");
+		if (!dir)
+			dir = VCAMERADIR;
+		cam->vcameradir = strdup(dir);
+		gp_log (GP_LOG_DEBUG, __FUNCTION__, "port '%s' serves images from %s", port, cam->vcameradir);
+	}
+	read_tree(cam, cam->vcameradir);
 #ifdef FUZZING
 	char *s = strchr(port,':');
 
@@ -2375,8 +2428,9 @@ vcamera_new(vcameratype type) {
 	cam = calloc(1,sizeof(vcamera));
 	if (!cam) return NULL;
 
-	const char *vcameradir_env = getenv("VCAMERADIR");
-	read_tree(cam, vcameradir_env != NULL ? vcameradir_env : VCAMERADIR);
+	/* byzanz-capture (patch 0006): the object tree is read in vcam_open,
+	 * not here — only open() learns the port, and the source directory
+	 * is resolved per port (see vcam_open). */
 
 	cam->init = vcam_init;
 	cam->exit = vcam_exit;
