+/* byzanz-capture (patch 0007): ExposureIndex (ISO), mirroring the
+ * fnumber property's structure. A realistic third-stop ladder
+ * (100 .. 12800, D750-ish) so the apps' ISO dropdown is populated the
+ * way a real body would; the value is stored but — like all exposure
+ * properties here — has no effect on the produced images. */
+static int
+ptp_exposureindex_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	static const uint16_t isos[] = {
+		100, 125, 160, 200, 250, 320, 400, 500, 640, 800, 1000,
+		1250, 1600, 2000, 2500, 3200, 4000, 5000, 6400, 8000,
+		10000, 12800,
+	};
+	unsigned int i, n = sizeof(isos)/sizeof(isos[0]);
+
+	desc->DevicePropCode		= 0x500F;
+	desc->DataType			= 0x0004;	/* UINT16 */
+	desc->GetSet			= 1;		/* Get/Set */
+	if (!cam->iso) cam->iso = 100;
+	desc->DefaultValue.u16		= cam->iso;
+	desc->CurrentValue.u16		= cam->iso;
+	desc->FormFlag			= 0x02; /* enum */
+	desc->FORM.Enum.NumberOfValues	= n;
+	desc->FORM.Enum.SupportedValue	= malloc(n*sizeof(desc->FORM.Enum.SupportedValue[0]));
+	for (i = 0; i < n; i++)
+		desc->FORM.Enum.SupportedValue[i].u16 = isos[i];
+
+	ptp_inject_interrupt (cam, 1000, 0x4006, 1, 0x500F, 0xffffffff);
+	return 1;
+}
+
+static int
+ptp_exposureindex_getvalue (vcamera* cam, PTPPropValue *val) {
+	if (!cam->iso) cam->iso = 100;
+	val->u16 = cam->iso;
+	ptp_inject_interrupt (cam, 1000, 0x4006, 1, 0x500F, 0xffffffff);
+	return 1;
+}
+
+static int
+ptp_exposureindex_setvalue (vcamera* cam, PTPPropValue *val) {
+	ptp_inject_interrupt (cam, 1000, 0x4006, 1, 0x500F, 0xffffffff);
+	gp_log (GP_LOG_DEBUG, __FUNCTION__, "got %d as value", val->u16);
+	cam->iso = val->u16;
+	return 1;
+}
+
+/* byzanz-capture (patch 0007): Nikon vendor exposure time (0xD100),
+ * encoded (numerator<<16)|denominator like a real body. A full D750-ish
+ * third-stop ladder 1/4000 .. 30 s plus Time/Bulb, so the ptp2
+ * "shutterspeed2" widget shows exactly the labels a real Nikon shows
+ * ("1/250", "4/10", "13/10", "2", "Time", "Bulb"). Stored, not acted
+ * on — captures are instant regardless of the selected time. */
+#define NIKON_SHUTTER(n,d)	((unsigned int)(((n)<<16)|(d)))
+
+static int
+ptp_nikon_exposuretime_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	static const uint32_t times[] = {
+		/* 1/x third stops, fast to slow */
+		NIKON_SHUTTER(1,4000), NIKON_SHUTTER(1,3200), NIKON_SHUTTER(1,2500),
+		NIKON_SHUTTER(1,2000), NIKON_SHUTTER(1,1600), NIKON_SHUTTER(1,1250),
+		NIKON_SHUTTER(1,1000), NIKON_SHUTTER(1,800),  NIKON_SHUTTER(1,640),
+		NIKON_SHUTTER(1,500),  NIKON_SHUTTER(1,400),  NIKON_SHUTTER(1,320),
+		NIKON_SHUTTER(1,250),  NIKON_SHUTTER(1,200),  NIKON_SHUTTER(1,160),
+		NIKON_SHUTTER(1,125),  NIKON_SHUTTER(1,100),  NIKON_SHUTTER(1,80),
+		NIKON_SHUTTER(1,60),   NIKON_SHUTTER(1,50),   NIKON_SHUTTER(1,40),
+		NIKON_SHUTTER(1,30),   NIKON_SHUTTER(1,25),   NIKON_SHUTTER(1,20),
+		NIKON_SHUTTER(1,15),   NIKON_SHUTTER(1,13),   NIKON_SHUTTER(1,10),
+		NIKON_SHUTTER(1,8),    NIKON_SHUTTER(1,6),    NIKON_SHUTTER(1,5),
+		NIKON_SHUTTER(1,4),    NIKON_SHUTTER(1,3),
+		/* sub-second, Nikon x/10 style */
+		NIKON_SHUTTER(4,10),   NIKON_SHUTTER(5,10),   NIKON_SHUTTER(6,10),
+		NIKON_SHUTTER(8,10),
+		/* whole seconds (denominator 1 renders as "x") + thirds */
+		NIKON_SHUTTER(1,1),    NIKON_SHUTTER(13,10),  NIKON_SHUTTER(16,10),
+		NIKON_SHUTTER(2,1),    NIKON_SHUTTER(25,10),  NIKON_SHUTTER(3,1),
+		NIKON_SHUTTER(4,1),    NIKON_SHUTTER(5,1),    NIKON_SHUTTER(6,1),
+		NIKON_SHUTTER(8,1),    NIKON_SHUTTER(10,1),   NIKON_SHUTTER(13,1),
+		NIKON_SHUTTER(15,1),   NIKON_SHUTTER(20,1),   NIKON_SHUTTER(25,1),
+		NIKON_SHUTTER(30,1),
+		/* specials, labeled by the ptp2 widget itself */
+		0xfffffffd, /* Time */
+		0xffffffff, /* Bulb */
+	};
+	unsigned int i, n = sizeof(times)/sizeof(times[0]);
+
+	desc->DevicePropCode		= 0xD100;
+	desc->DataType			= 0x0006;	/* UINT32 */
+	desc->GetSet			= 1;		/* Get/Set */
+	if (!cam->nikon_exposuretime) cam->nikon_exposuretime = NIKON_SHUTTER(1,100);
+	desc->DefaultValue.u32		= cam->nikon_exposuretime;
+	desc->CurrentValue.u32		= cam->nikon_exposuretime;
+	desc->FormFlag			= 0x02; /* enum */
+	desc->FORM.Enum.NumberOfValues	= n;
+	desc->FORM.Enum.SupportedValue	= malloc(n*sizeof(desc->FORM.Enum.SupportedValue[0]));
+	for (i = 0; i < n; i++)
+		desc->FORM.Enum.SupportedValue[i].u32 = times[i];
+
+	return 1;
+}
+
+static int
+ptp_nikon_exposuretime_getvalue (vcamera* cam, PTPPropValue *val) {
+	if (!cam->nikon_exposuretime) cam->nikon_exposuretime = NIKON_SHUTTER(1,100);
+	val->u32 = cam->nikon_exposuretime;
+	return 1;
+}
+
+static int
+ptp_nikon_exposuretime_setvalue (vcamera* cam, PTPPropValue *val) {
+	gp_log (GP_LOG_DEBUG, __FUNCTION__, "got 0x%08x as value", val->u32);
+	cam->nikon_exposuretime = val->u32;
+	return 1;
+}
+
 
