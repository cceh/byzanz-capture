+/* byzanz-capture (patch 0009): Nikon LiveViewImageZoomRatio (0xD1A3),
+ * Get/Set. The enum mirrors ptp2's nikon_liveviewimagezoomratio table
+ * (0 = Entire Display, 2 = 25%, 4 = 50%, 6 = 100%, 7 = 200%). The
+ * emulation only distinguishes zoomed vs not (every ratio > 0 serves
+ * the same liveview_zoom/ sequence); the chosen value is stored so a
+ * readback round-trips like on a real body. No DevicePropChanged
+ * injection — same reasoning as LiveViewStatus above. */
+static int
+ptp_nikon_liveviewzoom_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	static const uint8_t ratios[] = { 0, 2, 4, 6, 7 };
+	unsigned int i, n = sizeof(ratios)/sizeof(ratios[0]);
+
+	desc->DevicePropCode		= 0xD1A3;
+	desc->DataType			= 2;	/* uint8 */
+	desc->GetSet			= 1;	/* Get/Set */
+	desc->DefaultValue.u8		= 0;
+	desc->CurrentValue.u8		= cam->liveview_zoom;
+	desc->FormFlag			= 0x02; /* enum */
+	desc->FORM.Enum.NumberOfValues	= n;
+	desc->FORM.Enum.SupportedValue	= malloc(n*sizeof(desc->FORM.Enum.SupportedValue[0]));
+	for (i = 0; i < n; i++)
+		desc->FORM.Enum.SupportedValue[i].u8 = ratios[i];
+	return 1;
+}
+
+static int
+ptp_nikon_liveviewzoom_getvalue (vcamera* cam, PTPPropValue *val) {
+	val->u8 = cam->liveview_zoom;
+	return 1;
+}
+
+static int
+ptp_nikon_liveviewzoom_setvalue (vcamera* cam, PTPPropValue *val) {
+	gp_log (GP_LOG_DEBUG, __FUNCTION__, "got %d as value", val->u8);
+	cam->liveview_zoom = val->u8;
+	return 1;
+}
+
