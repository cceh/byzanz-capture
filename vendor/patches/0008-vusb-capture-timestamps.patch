diff --git a/libgphoto2_port/vusb/vcamera.c b/libgphoto2_port/vusb/vcamera.c
index fded1246c..6b7a723dd 100644
--- a/libgphoto2_port/vusb/vcamera.c
+++ b/libgphoto2_port/vusb/vcamera.c
@@ -463,17 +463,23 @@ struct ptp_dirent {
  * gives each camera its own virtual filesystem, as two real cameras have. */
 
 static void *read_file(struct ptp_dirent *cur) {
-	/* byzanz-capture (patch 0006): refresh the cached stat before
-	 * reading. The tree caches stbuf at scan time; a seed image swapped
-	 * on disk since (live content switching while testing) would
-	 * otherwise be read with the stale size — truncated or over-read.
-	 * The GetObject/GetThumb handlers pass cur->stbuf.st_size to
-	 * ptp_senddata right after this call, so refreshing here keeps the
-	 * data phase consistent with what is actually sent. */
-	if (-1 == stat(cur->fsname, &cur->stbuf)) {
+	/* byzanz-capture (patches 0006/0008): refresh only the SIZE from
+	 * disk before reading. The tree caches stbuf at scan time; a seed
+	 * image swapped on disk since (live content switching while
+	 * testing) would otherwise be read with the stale size — truncated
+	 * or over-read. The GetObject/GetThumb handlers pass
+	 * cur->stbuf.st_size to ptp_senddata right after this call, so this
+	 * keeps the data phase consistent with what is actually sent.
+	 * Deliberately NOT a wholesale stbuf refresh: the rest — notably
+	 * the capture-time st_mtime stamped by InitiateCapture (patch
+	 * 0008) — must survive, because GetObjectInfo calls read_file (for
+	 * the EXIF thumbnail) BEFORE packing the dates from cur->stbuf. */
+	struct stat st;
+	if (-1 == stat(cur->fsname, &st)) {
 		gp_log (GP_LOG_ERROR,__FUNCTION__, "could not stat %s", cur->fsname);
 		return NULL;
 	}
+	cur->stbuf.st_size = st.st_size;
 	FILE *file = fopen(cur->fsname, "rb");
 	if (!file) {
 		gp_log (GP_LOG_ERROR,__FUNCTION__, "could not open %s", cur->fsname);
@@ -1225,12 +1231,18 @@ ptp_getobjectinfo_write(vcamera *cam, ptpcontainer *ptp) {
 	x += put_32bit_le (data+x, 0); 		/* SequenceNumber */
 	x += put_string (data+x, cur->name); 	/* Filename */
 
+	/* byzanz-capture (patch 0008): localtime, not gmtime. PTP DateTime
+	 * strings carry no timezone and are local wall clock by convention —
+	 * the host parses them as local time (ptp_unpack_PTPTIME/mktime).
+	 * gmtime shifted every date by the UTC offset, which made captures
+	 * look hours old the moment they were taken (papyri's calibration
+	 * due-tracker judges freshness by exactly this date). */
 	xtime = cur->stbuf.st_ctime;
-	tm = gmtime(&xtime);
+	tm = localtime(&xtime);
 	sprintf(xdate,"%04d%02d%02dT%02d%02d%02d",tm->tm_year+1900,tm->tm_mon+1,tm->tm_mday,tm->tm_hour,tm->tm_min,tm->tm_sec);
 	x += put_string (data+x, xdate);	/* CreationDate */
 	xtime = cur->stbuf.st_mtime;
-	tm = gmtime(&xtime);
+	tm = localtime(&xtime);
 	sprintf(xdate,"%04d%02d%02dT%02d%02d%02d",tm->tm_year+1900,tm->tm_mon+1,tm->tm_mday,tm->tm_hour,tm->tm_min,tm->tm_sec);
 	x += put_string (data+x, xdate);	/* ModificatioDate */
 
@@ -1418,6 +1430,16 @@ ptp_initiatecapture_write(vcamera *cam, ptpcontainer *ptp) {
 	newcur->id	= ++cam->ptp_objectid;
 	newcur->fsname	= strdup(cur->fsname);
 	newcur->stbuf	= cur->stbuf;
+	/* byzanz-capture (patch 0008): stamp the CAPTURE moment as the new
+	 * image's date, like a real body does. The duplicated seed file's
+	 * own mtime is whenever the test material was seeded — hours or
+	 * days ago. GetObjectInfo serves these dates, the host applies them
+	 * to the downloaded file's mtime, and papyri's calibration
+	 * due-tracker judges freshness by exactly that mtime — captures
+	 * must not arrive pre-aged. st_ctime feeds CreationDate the same
+	 * way. */
+	newcur->stbuf.st_mtime = time(NULL);
+	newcur->stbuf.st_ctime = newcur->stbuf.st_mtime;
 	newcur->parent	= dir;
 	newcur->next	= cam->first_dirent;
 	newcur->name	= malloc(8+3+1+1);
@@ -2151,7 +2173,9 @@ ptp_datetime_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
 	desc->DataType		= 0xffff;	/* string */
 	desc->GetSet		= 1;		/* get only */
 	time(&xtime);
-	tm = gmtime(&xtime);
+	/* byzanz-capture (patch 0008): localtime — PTP DateTime is local
+	 * wall clock (see the ObjectInfo dates for the full rationale). */
+	tm = localtime(&xtime);
 	desc->DefaultValue.str	= aprintf("%04d%02d%02dT%02d%02d%02d",tm->tm_year+1900,tm->tm_mon+1,tm->tm_mday,tm->tm_hour,tm->tm_min,tm->tm_sec);
 	desc->CurrentValue.str	= strdup (desc->DefaultValue.str);
 	desc->FormFlag		= 0; /* no form */
@@ -2165,7 +2189,8 @@ ptp_datetime_getvalue (vcamera* cam, PTPPropValue *val) {
 	time_t			xtime;
 
 	time(&xtime);
-	tm = gmtime(&xtime);
+	/* byzanz-capture (patch 0008): localtime, see ObjectInfo dates. */
+	tm = localtime(&xtime);
 	val->str = aprintf("%04d%02d%02dT%02d%02d%02d",tm->tm_year + 1900,tm->tm_mon + 1,tm->tm_mday,tm->tm_hour,tm->tm_min,tm->tm_sec);
 	/*ptp_inject_interrupt (cam, 1000, 0x4006, 1, 0x5011, 0xffffffff);*/
 	return 1;
